DISCORD_TOKEN=
GEMINI_API_KEY=

# Optional
OWNER_ID=
# Channel where moderation actions are logged (right-click channel > Copy Channel ID)
MOD_LOG_CHANNEL_ID=
# Seconds to wait for another app's reply after sending it a command
APP_WAIT_SECONDS=8

# Auto-moderation (off by default): deletes + short timeout, never bans. Admins/mods are exempt.
AUTOMOD=false
AUTOMOD_SPAM_COUNT=6
AUTOMOD_SPAM_SECONDS=8
AUTOMOD_MENTION_LIMIT=5
AUTOMOD_BLOCK_INVITES=false
AUTOMOD_TIMEOUT_MINUTES=10

# Who may use "talk to other apps" and moderation tools: mod | everyone | owner
APP_TOOL_PERMISSION=mod
MOD_TOOL_PERMISSION=mod
# Use the stronger model right away for messages that look like actions (recommended)
ACTION_MODEL_FOR_TOOLS=true
# Optional privileged intent: show online/offline in member lists (enable it in the Developer Portal too)
PRESENCE_INTENT=false
# Known prefixes of other bots (copy app_profiles.example.json to app_profiles.json)
# APP_PROFILES_PATH=app_profiles.json

# ---- Warnings (strikes) ----
# Warnings older than this many days stop counting (0 = never)
WARN_EXPIRE_DAYS=30
# At N active warnings the person is timed out for M minutes: "N:M,N:M". Empty = never auto-punish.
WARN_ESCALATION=3:60,5:1440

# ---- Reminders ----
# How times like "6pm" are understood (IANA name, e.g. Asia/Kolkata, Europe/London, America/New_York)
TIMEZONE=Asia/Kolkata

# ---- Event log ----
# Easiest: run /neuro setlog in Discord. Or set a channel id here (falls back to MOD_LOG_CHANNEL_ID).
EVENT_LOG_CHANNEL_ID=
# What to log: messages, members, roles, channels, bans, voice
EVENT_LOG_EVENTS=messages,members,roles,channels,bans
# Joins from accounts younger than this many days are flagged
NEW_ACCOUNT_DAYS=7

# ---- Server builder ----
# Channels per build (1-6 recommended) and new roles per build
BUILD_MAX_CHANNELS=6
BUILD_MAX_ROLES=4
# Confirmed builds per server per 24h
BUILD_PER_DAY=10
# Minutes a plan waits for the Confirm button
BUILD_DRAFT_MINUTES=20
# Who may use the builder / edit tools: mod | everyone | owner (they still need Manage Channels / Manage Roles)
BUILD_TOOL_PERMISSION=mod

# ---- Games ----
GAMES_ENABLED=true
GAME_DEFAULT_ROUNDS=5
GAME_MAX_ROUNDS=10
# Games running at once per server
GAME_MAX_PER_SERVER=3
# A game nobody touches ends after this many minutes
GAME_IDLE_MINUTES=10
# Seconds per round
GAME_RIDDLE_SECONDS=60
GAME_TRIVIA_SECONDS=25
GAME_SCRAMBLE_SECONDS=40
GAME_HANGMAN_SECONDS=120
GAME_WYR_SECONDS=30
# Who may start games: mod | everyone | owner
GAME_TOOL_PERMISSION=everyone
