DISCORD_TOKEN=
GEMINI_API_KEY=

# Optional
OWNER_ID=
# Channel where moderation actions are logged (right-click channel > Copy Channel ID)
MOD_LOG_CHANNEL_ID=
# Seconds to wait for another app's reply after sending it a command
APP_WAIT_SECONDS=8

# Auto-moderation (off by default): deletes + short timeout, never bans. Admins/mods are exempt.
AUTOMOD=false
AUTOMOD_SPAM_COUNT=6
AUTOMOD_SPAM_SECONDS=8
AUTOMOD_MENTION_LIMIT=5
AUTOMOD_BLOCK_INVITES=false
AUTOMOD_TIMEOUT_MINUTES=10
